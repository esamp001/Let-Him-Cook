## Environment variables for the backend server
NODE_ENV=development
PORT=YOUR_API_PORT
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:YOUR_DB_PORT/YOUR_DATABASE_NAME
CORS_ORIGIN=YOUR_FRONTEND_URL

### Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Optional: a smaller model used only when importing free-form recipe text.
# Run `ollama pull qwen3:1.7b` before enabling this value.
OLLAMA_IMPORT_MODEL=qwen3:1.7b

# Meal DB
THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1
