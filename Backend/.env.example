## Environment variables for the backend server
NODE_ENV=development
PORT=YOUR_API_PORT
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:YOUR_DB_PORT/YOUR_DATABASE_NAME
CORS_ORIGIN=YOUR_FRONTEND_URL

### Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Optional: a smaller model used only when importing free-form recipe text.
# Run `ollama pull qwen3:1.7b` before enabling this value.
OLLAMA_IMPORT_MODEL=qwen3:1.7b

# Meal DB
THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1

### Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Must exactly match an "Authorized redirect URI" on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

### Account emails (password reset and email verification)
# Frontend address used in emailed links.
APP_URL=http://localhost:5173
# Leave SMTP_HOST empty in development to print emails to the backend console instead.
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_FROM="Let Him Cook <no-reply@yourdomain.com>"

### Proxy
# Set to 1 when running behind one reverse proxy such as Nginx, so rate limits use the real client IP.
TRUST_PROXY_HOPS=0

### Admin account (created by migrate-all-tenants.bat through the admin seed; the only way to create an admin)
# Leave these unset in development to use the defaults: admin@lethimcook.local / Let Him Cook Admin / Admin@12345.
# Required in production: the seed refuses to use the default password.
ADMIN_EMAIL=admin@lethimcook.local
ADMIN_NAME=Let Him Cook Admin
ADMIN_PASSWORD=Admin@12345
